# Allow-list: the image gets only the tool. Everything else — lectures (jobs/), keys (.env), the
# Python environment, the parked monorepo (apps/, packages/, infra/), node_modules, docs — stays out.
*
!scripts/
!ui/
!.claude/skills/
!VERSION
!README.md

# never, even if the allow-list changes
jobs/
.env
.env.*
.venv/
.data/
apps/
packages/
infra/
node_modules/
dist/
docs/
**/__pycache__/
**/*.pyc
**/.DS_Store
